<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Economy_sim.OptionsWindow"
        Title="Options"
        WindowState="FullScreen">

	<Window.Resources>
		<!-- Use same background as main menu for consistency -->
		<ImageBrush x:Key="OptionsBackgroundBrush"
		           Source="avares://Economy sim/Assets/main menu.png"
		           Stretch="UniformToFill"/>
	</Window.Resources>

	<Window.Styles>
		<StyleInclude Source="/GlobalStyles.axaml"/>
	</Window.Styles>

	<!-- Viewbox will scale the content uniformly based on design dimensions -->
	<Viewbox Stretch="Uniform">
		<Grid Width="800" Height="450" Background="{StaticResource OptionsBackgroundBrush}">
			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
				<!-- Title -->
				<Grid HorizontalAlignment="Center" Margin="0,0,0,40">
					<!-- Black outline layer (back) -->
					<TextBlock Text="Options" Classes="heading-large-outline"
					          HorizontalAlignment="Center" />
					<!-- White text layer (front) -->
					<TextBlock Text="Options" Classes="heading-large-white"
					          HorizontalAlignment="Center" />
				</Grid>

				<!-- Process Countries Button -->
				<Button x:Name="ProcessCountriesButton" 
				        Content="Process 1950 Countries from CShapes" 
				        Classes="menu-button" 
				        HorizontalAlignment="Center" 
				        Width="400" />

				<!-- Map Editor Button -->
				<Button x:Name="MapEditorButton" 
				        Content="Map Editor" 
				        Classes="menu-button" 
				        HorizontalAlignment="Center" 
				        Width="400" />

				<!-- Status Text -->
				<TextBlock x:Name="StatusText"
				          Text=""
				          HorizontalAlignment="Center"
				          Foreground="White"
				          FontSize="14"
				          Margin="0,10,0,0"
				          TextWrapping="Wrap"
				          MaxWidth="600" />

				<!-- Back to Main Menu Button -->
				<Button x:Name="BackToMainMenuButton" 
				        Content="Back to Main Menu" 
				        Classes="menu-button" 
				        HorizontalAlignment="Center" 
				        Margin="0,20,0,0" />
			</StackPanel>
		</Grid>
	</Viewbox>

</Window>