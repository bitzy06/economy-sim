<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StrategyGame.ConstructionWindow"
        Width="400" Height="300"
        Title="Construction Projects">
    <Grid Margin="10">
        <ListBox x:Name="ProjectsList"/>
        <Button x:Name="StartButton" Content="Start" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,10" Width="80"/>
    </Grid>
</Window>
