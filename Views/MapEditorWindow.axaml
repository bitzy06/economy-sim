<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Economy_sim.MapEditorWindow"
        Title="Map Editor"
        WindowState="FullScreen"
        Background="#2D2D30">

	<Window.Styles>
		<StyleInclude Source="/GlobalStyles.axaml"/>
	</Window.Styles>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="60"/>
		</Grid.RowDefinitions>

		<!-- Main Map Area -->
		<Grid Grid.Row="0">
			<!-- Map Container -->
			<Border x:Name="MapContainer"
				Background="Transparent"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				IsHitTestVisible="True">
				<Image x:Name="MapImage"
					   Stretch="None"
					   HorizontalAlignment="Left"
					   VerticalAlignment="Top"
					   IsHitTestVisible="True"/>
			</Border>

			<!-- Title Overlay -->
			<Border Background="#AA000000"
					Height="50"
					VerticalAlignment="Top"
					HorizontalAlignment="Stretch"
					IsHitTestVisible="False">
				<StackPanel Orientation="Horizontal"
							HorizontalAlignment="Center"
							VerticalAlignment="Center">
					<TextBlock Text="Map Editor - Political View"
							   Foreground="#FFD700"
							   FontSize="24"
							   FontWeight="Bold"/>
				</StackPanel>
			</Border>
		</Grid>

		<!-- Bottom Ribbon -->
		<Border Grid.Row="1"
				Background="#AA000000"
				BorderBrush="#555555"
				BorderThickness="0,1,0,0">
			<Grid Margin="10">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<!-- Left side - Future expansion area -->
				<StackPanel Grid.Column="0" 
							Orientation="Horizontal"
							VerticalAlignment="Center">
					<TextBlock Text="Map Editor Tools - Ready for Future Expansion"
							   Foreground="#AAAAAA"
							   FontSize="14"
							   VerticalAlignment="Center"/>
				</StackPanel>

				<!-- Right side - Exit button -->
				<Button Grid.Column="1"
						x:Name="ExitButton"
						Content="Exit"
						Width="100"
						Height="35"
						Background="#555555"
						Foreground="White"
						BorderBrush="#777777"
						BorderThickness="1"
						CornerRadius="3"/>
			</Grid>
		</Border>
	</Grid>
</Window>