<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Economy_sim.GameView"
        Title="GameView"
        WindowState="FullScreen"
        Background="#2D2D30"
        Width="2560" Height="1440">

	<Window.Styles>
		<StyleInclude Source="/GlobalStyles.axaml"/>
	</Window.Styles>

	<!-- Root grid now reserves space for a right-side column when the side menu is visible -->
	<Grid x:Name="RootGrid">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<!-- Increased side menu width from 420 to 600 for better data display -->
			<ColumnDefinition Width="0"/>
		</Grid.ColumnDefinitions>

		<!-- Main Content Area (shifts left when side menu column is occupied) -->
		<Grid Grid.Column="0">
			<!-- Map Layer (Background) -->
			<Border x:Name="MapContainer"
				Background="Transparent"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				IsHitTestVisible="True">
				<Image x:Name="MapImage"
					   Stretch="None"
					   HorizontalAlignment="Left"
					   VerticalAlignment="Top"
					   IsHitTestVisible="True"/>
			</Border>

			<!-- HUD Overlay Layers -->
			<!-- Top HUD Bar -->
			<Border Background="#AA000000"
					Height="50"
					VerticalAlignment="Top"
					HorizontalAlignment="Stretch"
					Margin="0"
					IsHitTestVisible="True"
					ZIndex="1000">
				<StackPanel Orientation="Horizontal"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Center"
							Margin="10,0"
							IsHitTestVisible="True">

					<!-- Player Role Section -->
					<Border Background="#222222"
							CornerRadius="3"
							Padding="12,6"
							Margin="0,0,15,0"
							BorderBrush="#555555"
							BorderThickness="1"
							IsHitTestVisible="False">
						<StackPanel Orientation="Horizontal">
							<TextBlock x:Name="PlayerRoleText"
									   Text="Prime Minister"
									   Foreground="#FFD700"
									   FontWeight="Bold"
									   FontSize="14"
									   VerticalAlignment="Center"/>
							<TextBlock Text=" of "
									   Foreground="#AAAAAA"
									   FontSize="12"
									   Margin="5,0,0,0"
									   VerticalAlignment="Center"/>
							<TextBlock x:Name="ControlledEntityText"
									   Text="United States"
									   Foreground="#FFFFFF"
									   FontWeight="Bold"
									   FontSize="14"
									   VerticalAlignment="Center"/>
						</StackPanel>
					</Border>

					<!-- Treasury Section -->
					<Border Background="#1A4A1A"
							CornerRadius="3"
							Padding="12,6"
							Margin="0,0,15,0"
							BorderBrush="#2A6A2A"
							BorderThickness="1"
							IsHitTestVisible="False">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="💰"
									   FontSize="16"
									   VerticalAlignment="Center"
									   Margin="0,0,6,0"/>
							<TextBlock x:Name="TreasuryText"
									   Text="$1,000,000"
									   Foreground="#90EE90"
									   FontWeight="Bold"
									   FontSize="14"
									   VerticalAlignment="Center"/>
						</StackPanel>
					</Border>

					<!-- Population Section -->
					<Border Background="#1A1A4A"
							CornerRadius="3"
							Padding="12,6"
							Margin="0,0,15,0"
							BorderBrush="#2A2A6A"
							BorderThickness="1"
							IsHitTestVisible="False">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="👥"
									   FontSize="16"
									   VerticalAlignment="Center"
									   Margin="0,0,6,0"/>
							<TextBlock x:Name="PopulationText"
									   Text="10,000,000"
									   Foreground="#ADD8E6"
									   FontWeight="Bold"
									   FontSize="14"
									   VerticalAlignment="Center"/>
						</StackPanel>
					</Border>

					<!-- Spacer -->
					<Border HorizontalAlignment="Stretch" IsHitTestVisible="False"/>

					<!-- Date/Time Section -->
					<Border Background="#4A1A1A"
							CornerRadius="3"
							Padding="12,6"
							BorderBrush="#6A2A2A"
							BorderThickness="1"
							IsHitTestVisible="False">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="📅"
									   FontSize="16"
									   VerticalAlignment="Center"
									   Margin="0,0,6,0"/>
							<TextBlock x:Name="DateTimeText"
									   Text="January 1950"
									   Foreground="#F0E68C"
									   FontWeight="Bold"
									   FontSize="14"
									   VerticalAlignment="Center"/>
						</StackPanel>
					</Border>

					<!-- Time Control Section -->
					<Border Background="#2D2D30"
							CornerRadius="3"
							Padding="8,4"
							Margin="15,0,0,0"
							BorderBrush="#555555"
							BorderThickness="1"
							IsHitTestVisible="True">
						<StackPanel Orientation="Horizontal" Spacing="8" IsHitTestVisible="True">
							<!-- Pause/Resume Button -->
							<Button x:Name="PauseResumeButton"
									Content="⏸"
									Width="36"
									Height="36"
									Background="#1A4A1A"
									BorderBrush="#2A6A2A"
									Foreground="White"
									FontSize="16"
									Padding="0"
									ToolTip.Tip="Pause/Resume Simulation"
									IsHitTestVisible="True"/>
							
							<!-- Speed Control Buttons -->
							<Border BorderBrush="#444444" BorderThickness="1,0,0,0" Padding="8,0,0,0" IsHitTestVisible="True">
								<StackPanel Orientation="Horizontal" Spacing="4" IsHitTestVisible="True">
									<Button x:Name="Speed05xButton"
											Content="0.5x"
											Width="42"
											Height="36"
											Background="#333333"
											BorderBrush="#555555"
											Foreground="#AAAAAA"
											FontSize="11"
											Padding="2"
											ToolTip.Tip="Slow Speed"
											IsHitTestVisible="True"/>
									<Button x:Name="Speed1xButton"
											Content="1x"
											Width="38"
											Height="36"
											Background="#1A4A1A"
											BorderBrush="#2A6A2A"
											Foreground="White"
											FontSize="11"
											FontWeight="Bold"
											Padding="2"
											ToolTip.Tip="Normal Speed"
											IsHitTestVisible="True"/>
									<Button x:Name="Speed2xButton"
											Content="2x"
											Width="38"
											Height="36"
											Background="#333333"
											BorderBrush="#555555"
											Foreground="#AAAAAA"
											FontSize="11"
											Padding="2"
											ToolTip.Tip="Fast Speed"
											IsHitTestVisible="True"/>
									<Button x:Name="Speed5xButton"
											Content="5x"
											Width="38"
											Height="36"
											Background="#333333"
											BorderBrush="#555555"
											Foreground="#AAAAAA"
											FontSize="11"
											Padding="2"
											ToolTip.Tip="Very Fast Speed"
											IsHitTestVisible="True"/>
									<Button x:Name="Speed10xButton"
											Content="10x"
											Width="42"
											Height="36"
											Background="#333333"
											BorderBrush="#555555"
											Foreground="#AAAAAA"
											FontSize="11"
											Padding="2"
											ToolTip.Tip="Ultra Fast Speed"
											IsHitTestVisible="True"/>
								</StackPanel>
							</Border>
							
							<!-- Speed Indicator -->
							<TextBlock x:Name="SpeedIndicatorText"
									   Text="1.0x"
									   Foreground="#90EE90"
									   FontWeight="Bold"
									   FontSize="13"
									   VerticalAlignment="Center"
									   Margin="4,0,0,0"
									   MinWidth="35"
									   IsHitTestVisible="False"/>
						</StackPanel>
					</Border>
				</StackPanel>
                        </Border>

			<!-- City Hover Tooltip -->
			<Border x:Name="CityHoverTooltip"
					Background="#E0000000"
					BorderBrush="#FFD700"
					BorderThickness="2"
					CornerRadius="4"
					Padding="10,6"
					MaxWidth="250"
					HorizontalAlignment="Left"
					VerticalAlignment="Top"
					ZIndex="2000"
					IsVisible="False"
					IsHitTestVisible="False">
				<StackPanel Spacing="2">
					<TextBlock x:Name="CityHoverNameText"
							   Text="City Name"
							   Foreground="#FFD700"
							   FontWeight="Bold"
							   FontSize="14"/>
					<TextBlock x:Name="CityHoverInfoText"
							   Text="Population: 0"
							   Foreground="#DDDDDD"
							   FontSize="11"
							   TextWrapping="Wrap"/>
				</StackPanel>
			</Border>

                        <!-- State Context Popup (appears near right-click position) -->
                        <Border x:Name="StateInfoPopup"
                                Background="#F01E1E1E"
                                BorderBrush="#555555"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="15,120,0,0"
                                Width="320"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                ZIndex="1150"
                                IsVisible="False"
                                IsHitTestVisible="True">
                                <StackPanel Spacing="10">
                                        <Grid>
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Vertical" Spacing="2">
                                                        <TextBlock x:Name="StateInfoNameText"
                                                                   Text="State"
                                                                   FontSize="17"
                                                                   FontWeight="Bold"
                                                                   Foreground="#FFD38B"/>
                                                        <TextBlock x:Name="StateInfoCountryText"
                                                                   Text="Country"
                                                                   FontSize="12"
                                                                   Foreground="#CCCCCC"/>
                                                </StackPanel>
                                                <Button x:Name="StateInfoCloseButton"
                                                        Grid.Column="1"
                                                        Content="✕"
                                                        Width="24"
                                                        Height="24"
                                                        Background="#444444"
                                                        Foreground="White"
                                                        BorderBrush="#666666"
                                                        CornerRadius="12"
                                                        Padding="0"
                                                        HorizontalAlignment="Right"/>
                                        </Grid>

                                        <TabControl x:Name="StateInfoTabControl">
                                                <TabItem Header="Economy">
                                                        <StackPanel Spacing="6" Margin="0,6,0,0">
                                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                                                                        <TextBlock Text="Budget" Foreground="#DDDDDD"/>
                                                                        <TextBlock x:Name="StateInfoBudgetText" Grid.Column="1" Text="$0" Foreground="#FFFFFF"/>
                                                                        <TextBlock Grid.Row="1" Text="GDP" Foreground="#DDDDDD"/>
                                                                        <TextBlock x:Name="StateInfoGdpText" Grid.Row="1" Grid.Column="1" Text="$0" Foreground="#FFFFFF"/>
                                                                        <TextBlock Grid.Row="2" Text="Growth" Foreground="#DDDDDD"/>
                                                                        <TextBlock x:Name="StateInfoGrowthText" Grid.Row="2" Grid.Column="1" Text="0%" Foreground="#90EE90"/>
                                                                        <TextBlock Grid.Row="3" Text="Inflation" Foreground="#DDDDDD"/>
                                                                        <TextBlock x:Name="StateInfoInflationText" Grid.Row="3" Grid.Column="1" Text="0%" Foreground="#F0E68C"/>
                                                                </Grid>
                                                                <ListBox x:Name="StateInfoHighlightsList" Height="110" Background="#22000000" Foreground="#FFFFFF" BorderBrush="#444444"/>
                                                        </StackPanel>
                                                </TabItem>
                                                <TabItem Header="Trade">
                                                        <StackPanel Spacing="6" Margin="0,6,0,0">
                                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" RowSpacing="4">
                                                                        <TextBlock Text="Balance" Foreground="#DDDDDD"/>
                                                                        <TextBlock x:Name="StateInfoTradeBalanceText" Grid.Column="1" Text="$0" Foreground="#FFFFFF"/>
                                                                </Grid>
                                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                                        <StackPanel>
                                                                                <TextBlock Text="Top Exports" FontSize="13" FontWeight="Bold" Foreground="#DDDDDD"/>
                                                                                <ListBox x:Name="StateInfoExportsList" Height="110" Background="#22000000" Foreground="#FFFFFF" BorderBrush="#444444"/>
                                                                        </StackPanel>
                                                                        <StackPanel>
                                                                                <TextBlock Text="Top Imports" FontSize="13" FontWeight="Bold" Foreground="#DDDDDD"/>
                                                                                <ListBox x:Name="StateInfoImportsList" Height="110" Background="#22000000" Foreground="#FFFFFF" BorderBrush="#444444"/>
                                                                        </StackPanel>
                                                                </Grid>
                                                        </StackPanel>
                                                </TabItem>
                                                <TabItem Header="Population">
                                                        <StackPanel Spacing="6" Margin="0,6,0,0">
                                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                                                        <TextBlock Text="Population" Foreground="#DDDDDD"/>
                                                                        <TextBlock x:Name="StateInfoPopulationText" Grid.Column="1" Text="0" Foreground="#FFFFFF"/>
                                                                        <TextBlock Grid.Row="1" Text="Urbanization" Foreground="#DDDDDD"/>
                                                                        <TextBlock x:Name="StateInfoUrbanizationText" Grid.Row="1" Grid.Column="1" Text="0%" Foreground="#FFFFFF"/>
                                                                        <TextBlock Grid.Row="2" Text="Growth" Foreground="#DDDDDD"/>
                                                                        <TextBlock x:Name="StateInfoPopGrowthText" Grid.Row="2" Grid.Column="1" Text="0%" Foreground="#FFFFFF"/>
                                                                </Grid>
                                                                <ListBox x:Name="StateInfoPopulationBreakdownList" Height="110" Background="#22000000" Foreground="#FFFFFF" BorderBrush="#444444"/>
                                                        </StackPanel>
                                                </TabItem>
                                        </TabControl>
                                </StackPanel>
                        </Border>

                        <!-- City Context Popup -->
                        <Border x:Name="CityInfoPopup"
                                Background="#F01E1E1E"
                                BorderBrush="#555555"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="15,360,0,0"
                                Width="300"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                ZIndex="1160"
                                IsVisible="False"
                                IsHitTestVisible="True">
                                <StackPanel Spacing="8">
                                        <Grid>
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                        <TextBlock x:Name="CityInfoNameText"
                                                                   Text="City"
                                                                   FontSize="16"
                                                                   FontWeight="Bold"
                                                                   Foreground="#FFEEA2"/>
                                                        <TextBlock x:Name="CityInfoStateText"
                                                                   Text="State"
                                                                   FontSize="12"
                                                                   Foreground="#CCCCCC"/>
                                                        <TextBlock x:Name="CityInfoCountryText"
                                                                   Text="Country"
                                                                   FontSize="12"
                                                                   Foreground="#999999"/>
                                                </StackPanel>
                                                <Button x:Name="CityInfoCloseButton"
                                                        Grid.Column="1"
                                                        Content="✕"
                                                        Width="24"
                                                        Height="24"
                                                        Background="#444444"
                                                        Foreground="White"
                                                        BorderBrush="#666666"
                                                        CornerRadius="12"
                                                        Padding="0"
                                                        HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                                <TextBlock Text="Budget" Foreground="#DDDDDD"/>
                                                <TextBlock x:Name="CityInfoBudgetText" Grid.Column="1" Text="$0" Foreground="#FFFFFF"/>
                                                <TextBlock Grid.Row="1" Text="Expenses" Foreground="#DDDDDD"/>
                                                <TextBlock x:Name="CityInfoExpensesText" Grid.Row="1" Grid.Column="1" Text="$0" Foreground="#FFFFFF"/>
                                                <TextBlock Grid.Row="2" Text="Tax Rate" Foreground="#DDDDDD"/>
                                                <TextBlock x:Name="CityInfoTaxText" Grid.Row="2" Grid.Column="1" Text="0%" Foreground="#FFFFFF"/>
                                                <TextBlock Grid.Row="3" Text="GDP" Foreground="#DDDDDD"/>
                                                <TextBlock x:Name="CityInfoGdpText" Grid.Row="3" Grid.Column="1" Text="$0" Foreground="#FFFFFF"/>
                                                <TextBlock Grid.Row="4" Text="Population" Foreground="#DDDDDD"/>
                                                <TextBlock x:Name="CityInfoPopulationText" Grid.Row="4" Grid.Column="1" Text="0" Foreground="#FFFFFF"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                                                <TextBlock Text="Employment" Foreground="#DDDDDD"/>
                                                <TextBlock x:Name="CityInfoEmploymentText" Grid.Column="1" Text="0%" Foreground="#90EE90"/>
                                                <TextBlock Grid.Row="1" Text="Quality of Life" Foreground="#DDDDDD"/>
                                                <TextBlock x:Name="CityInfoQualityText" Grid.Row="1" Grid.Column="1" Text="0.0" Foreground="#FFFFFF"/>
                                                <TextBlock Grid.Row="2" Text="Happiness" Foreground="#DDDDDD"/>
                                                <TextBlock x:Name="CityInfoHappinessText" Grid.Row="2" Grid.Column="1" Text="0%" Foreground="#FFD38B"/>
                                                <TextBlock Grid.Row="3" Text="Growth" Foreground="#DDDDDD"/>
                                                <TextBlock x:Name="CityInfoGrowthText" Grid.Row="3" Grid.Column="1" Text="0%" Foreground="#90EE90"/>
                                        </Grid>

                                        <StackPanel>
                                                <TextBlock Text="Highlights" FontWeight="Bold" Foreground="#DDDDDD"/>
                                                <ListBox x:Name="CityInfoHighlightsList" Height="80" Background="#22000000" Foreground="#FFFFFF" BorderBrush="#444444"/>
                                        </StackPanel>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                <StackPanel>
                                                        <TextBlock Text="Key Industries" FontWeight="Bold" Foreground="#DDDDDD"/>
                                                        <ListBox x:Name="CityInfoIndustriesList" Height="100" Background="#22000000" Foreground="#FFFFFF" BorderBrush="#444444"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Population" FontWeight="Bold" Foreground="#DDDDDD"/>
                                                        <ListBox x:Name="CityInfoPopulationBreakdownList" Height="100" Background="#22000000" Foreground="#FFFFFF" BorderBrush="#444444"/>
                                                </StackPanel>
                                        </Grid>
                                </StackPanel>
                        </Border>


                        <!-- Selected Country Overview Panel -->
                        <Border x:Name="SelectedCountryOverlay"
                                Background="#E61E1E1E"
                                BorderBrush="#555555"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="15,70,0,0"
                                Width="340"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                ZIndex="1100"
                                IsVisible="False"
                                IsHitTestVisible="True">
                                <StackPanel Spacing="10">
                                        <Grid>
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="SelectedCountryNameText"
                                                           Text="Country"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Foreground="#FFD700"/>
                                                <Button x:Name="SelectedCountryCloseButton"
                                                        Grid.Column="1"
                                                        Content="✕"
                                                        Width="26"
                                                        Height="26"
                                                        Background="#444444"
                                                        Foreground="White"
                                                        BorderBrush="#666666"
                                                        CornerRadius="13"
                                                        Padding="0"
                                                        HorizontalAlignment="Right"/>
                                        </Grid>

                                        <TextBlock x:Name="SelectedCountrySubheadingText"
                                                   Text="Country Overview"
                                                   Foreground="#CCCCCC"
                                                   FontSize="13"
                                                   IsVisible="False"/>

                                        <TabControl x:Name="SelectedCountryTabControl">
                                                <TabItem Header="Economy">
                                                        <StackPanel Spacing="6" Margin="0,6,0,0">
                                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                                                                        <TextBlock Grid.Row="0"
                                                                                   Text="Budget"
                                                                                   Foreground="#DDDDDD"/>
                                                                        <TextBlock x:Name="SelectedCountryBudgetText"
                                                                                   Grid.Row="0" Grid.Column="1"
                                                                                   Text="$0"
                                                                                   Foreground="#FFFFFF"
                                                                                   FontWeight="Bold"/>

                                                                        <TextBlock Grid.Row="1"
                                                                                   Text="GDP"
                                                                                   Foreground="#DDDDDD"/>
                                                                        <TextBlock x:Name="SelectedCountryGdpText"
                                                                                   Grid.Row="1" Grid.Column="1"
                                                                                   Text="$0"
                                                                                   Foreground="#FFFFFF"
                                                                                   FontWeight="Bold"/>

                                                                        <TextBlock Grid.Row="2"
                                                                                   Text="Growth"
                                                                                   Foreground="#DDDDDD"/>
                                                                        <TextBlock x:Name="SelectedCountryGrowthText"
                                                                                   Grid.Row="2" Grid.Column="1"
                                                                                   Text="0%"
                                                                                   Foreground="#90EE90"
                                                                                   FontWeight="Bold"/>

                                                                        <TextBlock Grid.Row="3"
                                                                                   Text="Inflation"
                                                                                   Foreground="#DDDDDD"/>
                                                                        <TextBlock x:Name="SelectedCountryInflationText"
                                                                                   Grid.Row="3" Grid.Column="1"
                                                                                   Text="0%"
                                                                                   Foreground="#F0E68C"
                                                                                   FontWeight="Bold"/>
                                                                </Grid>
                                                                <ListBox x:Name="SelectedCountryEconomicHighlightsList"
                                                                         Height="90"
                                                                         Background="#1E1E1E"
                                                                         BorderBrush="#333333"
                                                                         Margin="0,6,0,0"/>
                                                        </StackPanel>
                                                </TabItem>
                                                <TabItem Header="Trade">
                                                        <Grid Margin="0,6,0,0">
                                                                <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>
                                                                <StackPanel Orientation="Horizontal"
                                                                            Grid.Row="0"
                                                                            HorizontalAlignment="Stretch"
                                                                            Spacing="10">
                                                                        <TextBlock Text="Trade Balance"
                                                                                   Foreground="#DDDDDD"/>
                                                                        <TextBlock x:Name="SelectedCountryTradeBalanceText"
                                                                                   Text="$0"
                                                                                   Foreground="#87CEFA"
                                                                                   FontWeight="Bold"/>
                                                                </StackPanel>
                                                                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
                                                                        <StackPanel>
                                                                                <TextBlock Text="Top Exports"
                                                                                           Foreground="#90EE90"
                                                                                           FontWeight="Bold"/>
                                                                                <ListBox x:Name="SelectedCountryExportsList"
                                                                                         Height="120"
                                                                                         Background="#1E1E1E"
                                                                                         BorderBrush="#333333"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1">
                                                                                <TextBlock Text="Top Imports"
                                                                                           Foreground="#F08080"
                                                                                           FontWeight="Bold"/>
                                                                                <ListBox x:Name="SelectedCountryImportsList"
                                                                                         Height="120"
                                                                                         Background="#1E1E1E"
                                                                                         BorderBrush="#333333"/>
                                                                        </StackPanel>
                                                                </Grid>
                                                        </Grid>
                                                </TabItem>
                                                <TabItem Header="Population">
                                                        <StackPanel Spacing="6" Margin="0,6,0,0">
                                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                                                        <TextBlock Grid.Row="0"
                                                                                   Text="Population"
                                                                                   Foreground="#DDDDDD"/>
                                                                        <TextBlock x:Name="SelectedCountryPopulationText"
                                                                                   Grid.Row="0" Grid.Column="1"
                                                                                   Text="0"
                                                                                   Foreground="#FFFFFF"
                                                                                   FontWeight="Bold"/>

                                                                        <TextBlock Grid.Row="1"
                                                                                   Text="Urbanization"
                                                                                   Foreground="#DDDDDD"/>
                                                                        <TextBlock x:Name="SelectedCountryUrbanizationText"
                                                                                   Grid.Row="1" Grid.Column="1"
                                                                                   Text="0%"
                                                                                   Foreground="#ADD8E6"
                                                                                   FontWeight="Bold"/>

                                                                        <TextBlock Grid.Row="2"
                                                                                   Text="Pop Growth"
                                                                                   Foreground="#DDDDDD"/>
                                                                        <TextBlock x:Name="SelectedCountryPopGrowthText"
                                                                                   Grid.Row="2" Grid.Column="1"
                                                                                   Text="0%"
                                                                                   Foreground="#90EE90"
                                                                                   FontWeight="Bold"/>
                                                                </Grid>
                                                                <ListBox x:Name="SelectedCountryPopulationBreakdownList"
                                                                         Height="90"
                                                                         Background="#1E1E1E"
                                                                         BorderBrush="#333333"
                                                                         Margin="0,6,0,0"/>
                                                        </StackPanel>
                                                </TabItem>
                                        </TabControl>
                                </StackPanel>
                        </Border>

                        <!-- Right Side Button Panel -->
                        <StackPanel Orientation="Vertical"
                                                HorizontalAlignment="Right"
						VerticalAlignment="Center"
						Margin="10"
						Spacing="5"
						ZIndex="1000"
						IsHitTestVisible="True">
				<Button x:Name="PoliticalViewButton"
						Content="Political"
						Width="130"
						Height="50"
						IsHitTestVisible="True"/>
				<Button x:Name="TerrainViewButton"
						Content="Terrain"
						Width="130"
						Height="50"
						IsHitTestVisible="True"/>
				<Button x:Name="PlaceHolder1Button"
						Content="Population"
						Width="130"
						Height="50"
						IsHitTestVisible="True"/>
                                <Button x:Name="StatesViewButton"
                                                Content="States"
                                                Width="130"
                                                Height="50"
                                                IsHitTestVisible="True"/>
			</StackPanel>

			<!-- Bottom HUD Bar -->
			<Grid VerticalAlignment="Bottom"
	        HorizontalAlignment="Stretch"
	        Margin="0"
	        ZIndex="1000">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<!-- Left section (taller) -->
				<Border Grid.Column="0"
						Background="#AA000000"
						Height="200"
						VerticalAlignment="Bottom"
						HorizontalAlignment="Stretch">
					<Grid Margin="10"
						  IsHitTestVisible="True">
						<!-- Left side buttons -->
						<StackPanel Orientation="Horizontal"
									HorizontalAlignment="Left"
									VerticalAlignment="Center"
									Spacing="15"
									IsHitTestVisible="True">
							<!-- Main action buttons -->
							<Button x:Name="DiplomacyButton"
									Content="Diplomacy"
									Width="130"
									Height="50"
									IsHitTestVisible="True"/>
							<Button x:Name="TradeButton"
									Content="Trade"
									Width="130"
									Height="50"
									IsHitTestVisible="True"/>
							<Button x:Name="ConstructionButton"
									Content="Construction"
									Width="130"
									Height="50"
									IsHitTestVisible="True"/>

							

							<!-- View buttons -->
							<Button x:Name="EconomyViewButton"
									Content="Economy"
									Width="130"
									Height="50"
									IsHitTestVisible="True"/>
                                                        <Button x:Name="StatsButton"
                                                                        Content="Statistics"
                                                                        Width="130"
                                                                        Height="50"
                                                                        IsHitTestVisible="True"/>
                                                        <Button x:Name="DebugButton"
                                                                        Content="Debug"
                                                                        Width="130"
                                                                        Height="50"
                                                                        IsHitTestVisible="True"/>
						</StackPanel>
					</Grid>
				</Border>

				<!-- Right section (keeps current height) -->
				<Border Grid.Column="1"
						Background="#AA000000"
						Height="50"
						VerticalAlignment="Bottom"
						HorizontalAlignment="Stretch">
					<StackPanel Orientation="Horizontal"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								Margin="10,0"
								IsHitTestVisible="True">
						<Button x:Name="MenuButton"
								Content="Menu"
								Width="130"
								Height="50"
								IsHitTestVisible="True"
								ZIndex="2000"/>
					</StackPanel>
				</Border>
			</Grid>

			<!-- Popup Menu Overlays -->
			<!-- Diplomacy Menu Popup -->
			<Border x:Name="DiplomacyMenuOverlay"
					Background="#E6000000"
					IsVisible="False"
					ZIndex="5000"
					IsHitTestVisible="True">
				<Border Background="#2D2D30"
						BorderBrush="#555555"
						BorderThickness="2"
						CornerRadius="5"
						Width="600"
						Height="400"
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
                                        <Grid Margin="15">
                                                <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

						<!-- Header -->
						<Grid Grid.Row="0" Margin="0,0,0,15">
							<TextBlock Text="Diplomatic Relations"
									   FontSize="24"
									   FontWeight="Bold"
									   Foreground="#FFD700"
									   HorizontalAlignment="Left"/>
							<Button x:Name="DiplomacyCloseButton"
									Content="✕"
									Width="30"
									Height="30"
									HorizontalAlignment="Right"
									Background="#555555"
									Foreground="White"/>
						</Grid>

						<!-- Content -->
						<ScrollViewer Grid.Row="1">
							<StackPanel Spacing="10">
								<TextBlock Text="Relations with other countries:" Foreground="#DDDDDD" FontWeight="Bold"/>
								<ListBox x:Name="DiplomacyRelationsList"
										 Background="#1A1A1A"
										 BorderBrush="#444444"
										 Height="200">
								</ListBox>

								<TextBlock Text="Diplomatic Actions:" Foreground="#DDDDDD" FontWeight="Bold" Margin="0,20,0,5"/>
								<StackPanel Orientation="Horizontal" Spacing="10">
									<Button x:Name="ProposeTreatyButton" Content="Propose Treaty" Width="150"/>
									<Button x:Name="DeclareWarButton" Content="Declare War" Width="150" Background="#A93226"/>
									<Button x:Name="SendDiplomatButton" Content="Send Diplomat" Width="150"/>
								</StackPanel>
							</StackPanel>
						</ScrollViewer>
					</Grid>
				</Border>
			</Border>

			<!-- Trade Menu Popup -->
			<Border x:Name="TradeMenuOverlay"
					Background="#E6000000"
					IsVisible="False"
					ZIndex="5000"
					IsHitTestVisible="True">
				<Border Background="#2D2D30"
						BorderBrush="#555555"
						BorderThickness="2"
						CornerRadius="5"
						Width="650"
						Height="450"
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
					<Grid Margin="15">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>

						<!-- Header -->
						<Grid Grid.Row="0" Margin="0,0,0,15">
							<TextBlock Text="Trade Management"
									   FontSize="24"
									   FontWeight="Bold"
									   Foreground="#FFD700"
									   HorizontalAlignment="Left"/>
							<Button x:Name="TradeCloseButton"
									Content="✕"
									Width="30"
									Height="30"
									HorizontalAlignment="Right"
									Background="#555555"
									Foreground="White"/>
						</Grid>

                                                <!-- Content -->
                                                <Grid Grid.Row="1">
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Exports -->
                                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                                <TextBlock Text="Exports" Foreground="#90EE90" FontWeight="Bold" FontSize="16"/>
                                                                <ListBox x:Name="ExportsList"
                                                                                 ItemsSource="{Binding Exports}"
                                                                                 Background="#1E1E1E"
                                                                                 BorderBrush="#333333"
                                                                                 Height="150"
                                                                                 Margin="0,5,0,10">
                                                                </ListBox>
                                                                <Button x:Name="CreateExportButton" Content="Create Export Deal" Width="180" Command="{Binding CreateExportCommand}"/>
                                                        </StackPanel>

                                                        <!-- Imports -->
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                                <TextBlock Text="Imports" Foreground="#FFB6C1" FontWeight="Bold" FontSize="16"/>
                                                                <ListBox x:Name="ImportsList"
                                                                         ItemsSource="{Binding Imports}"
                                                                         Background="#1E1E1E"
                                                                         BorderBrush="#333333"
                                                                         Height="150"
                                                                         Margin="0,5,0,10">
                                                                </ListBox>
                                                                <Button x:Name="CreateImportButton" Content="Create Import Deal" Width="180" Command="{Binding CreateImportCommand}"/>
                                                        </StackPanel>
                                                </Grid>

                                                <StackPanel Grid.Row="2" Margin="0,15,0,0" Spacing="8">
                                                        <TextBlock Text="{Binding TradeSummaryText}" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                                                        <ItemsControl ItemsSource="{Binding Aggregates}">
                                                                <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                                <TextBlock Text="{Binding}" Foreground="#CCCCCC"/>
                                                                        </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="Recent Trade Events" Foreground="#87CEFA" FontWeight="Bold" FontSize="14" Margin="0,10,0,0"/>
                                                        <ListBox ItemsSource="{Binding RecentTradeEvents}" Background="#1A1A1A" BorderBrush="#444444" Height="120"/>
                                                </StackPanel>
                                        </Grid>
                                </Border>
                        </Border>

			<!-- Construction Menu Popup -->
			<Border x:Name="ConstructionMenuOverlay"
					Background="#E6000000"
					IsVisible="False"
					ZIndex="5000"
					IsHitTestVisible="True">
				<Border Background="#2D2D30"
						BorderBrush="#555555"
						BorderThickness="2"
						CornerRadius="5"
						Width="700"
						Height="500"
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
					<Grid Margin="15">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>

						<!-- Header -->
						<Grid Grid.Row="0" Margin="0,0,0,15">
							<TextBlock Text="Construction Projects"
									   FontSize="24"
									   FontWeight="Bold"
									   Foreground="#FFD700"
									   HorizontalAlignment="Left"/>
							<Button x:Name="ConstructionCloseButton"
									Content="✕"
									Width="30"
									Height="30"
									HorizontalAlignment="Right"
									Background="#555555"
									Foreground="White"/>
						</Grid>

						<!-- Content -->
						<Grid Grid.Row="1">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="2*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<!-- Project List -->
							<StackPanel Grid.Column="0" Margin="0,0,15,0">
                                                                <TextBlock Text="Active Projects" Foreground="#DDDDDD" FontWeight="Bold" FontSize="16"/>
                                                                <StackPanel Orientation="Vertical" Spacing="4" Margin="0,6,0,6">
                                                                    <TextBlock Text="{Binding CityBudgetDisplay}" Foreground="#AAAAAA" FontSize="12"/>
                                                                    <TextBlock Text="{Binding TotalAllocatedBudgetDisplay}" Foreground="#AAAAAA" FontSize="12"/>
                                                                    <TextBlock Text="{Binding EstimatedDailyCostDisplay}" Foreground="#AAAAAA" FontSize="12"/>
                                                                </StackPanel>
                                                                <ListBox x:Name="ActiveProjectsList"
                                                                         ItemsSource="{Binding ActiveProjects}"
                                                                         SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                                                         Background="#1A1A1A"
                                                                         BorderBrush="#444444"
                                                                         Height="250"
                                                                         Margin="0,5,0,0">
                                                                    <ListBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border BorderBrush="#333333" BorderThickness="1" Padding="8" Margin="0,0,0,6" Background="#202020">
                                                                                <StackPanel Spacing="4">
                                                                                    <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontWeight="Bold"/>
                                                                                    <ProgressBar Minimum="0" Maximum="100" Height="6" Value="{Binding ProgressPercentage}"/>
                                                                                    <TextBlock Text="{Binding ProgressText}" Foreground="#CCCCCC" FontSize="12"/>
                                                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                                                        <TextBlock Text="{Binding BudgetDisplay}" Foreground="#999999" FontSize="11"/>
                                                                                        <TextBlock Text="{Binding BudgetRemainingDisplay}" Foreground="#999999" FontSize="11"/>
                                                                                    </StackPanel>
                                                                                    <TextBlock Text="{Binding AssignedCompanyDisplay}" Foreground="#888888" FontSize="11"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ListBox.ItemTemplate>
                                                                </ListBox>
                                                        </StackPanel>

                                                        <!-- Project Actions -->
                                                        <StackPanel Grid.Column="1" Spacing="15">
								<TextBlock Text="New Projects" Foreground="#DDDDDD" FontWeight="Bold" FontSize="16"/>
                                                                <ComboBox ItemsSource="{Binding CompanyOptions}"
                                                                          SelectedItem="{Binding SelectedCompanyOption, Mode=TwoWay}"
                                                                          Width="160"
                                                                          HorizontalAlignment="Left"/>
                                                                <Button x:Name="BuildFactoryButton" Content="Build Factory" Width="160" Command="{Binding BuildFactoryCommand}"/>
                                                                <Button x:Name="BuildRoadButton" Content="Build Road" Width="160" Command="{Binding BuildRoadCommand}"/>
                                                                <Button x:Name="BuildBridgeButton" Content="Build Bridge" Width="160" Command="{Binding BuildBridgeCommand}"/>
                                                                <Button x:Name="BuildPortButton" Content="Build Port" Width="160" Command="{Binding BuildPortCommand}"/>
                                                                <Button x:Name="BuildAirportButton" Content="Build Airport" Width="160" Command="{Binding BuildAirportCommand}"/>

                                                                <TextBlock Text="Project Info" Foreground="#DDDDDD" FontWeight="Bold" FontSize="16" Margin="0,20,0,0"/>
                                                                <TextBlock x:Name="ProjectInfoText"
                                                                           Text="{Binding SelectedProjectSummary}"
                                                                           Foreground="#AAAAAA"
                                                                           TextWrapping="Wrap"
                                                                           Width="160"/>
							</StackPanel>
						</Grid>
					</Grid>
				</Border>
			</Border>

			<!-- Economy Menu Popup -->
			<Border x:Name="EconomyMenuOverlay"
					Background="#E6000000"
					IsVisible="False"
					ZIndex="5000"
					IsHitTestVisible="True">
				<Border Background="#2D2D30"
						BorderBrush="#555555"
						BorderThickness="2"
						CornerRadius="5"
						Width="900"
						Height="600"
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
					<Grid Margin="15">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>

						<!-- Header -->
						<Grid Grid.Row="0" Margin="0,0,0,15">
							<TextBlock Text="Economic Overview"
									   FontSize="24"
									   FontWeight="Bold"
									   Foreground="#FFD700"
									   HorizontalAlignment="Left"/>
							<Button x:Name="EconomyCloseButton"
									Content="✕"
									Width="30"
									Height="30"
									HorizontalAlignment="Right"
									Background="#555555"
									Foreground="White"/>
						</Grid>

						<!-- Sub-menu Tabs -->
						<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,15">
							<Button x:Name="PrivateSectorTabButton"
									Content="🏢 Private Sector"
									Width="180"
									Height="40"
									Background="#1A4A1A"
									Foreground="White"/>
							<Button x:Name="BudgetTabButton"
									Content="💰 Budget"
									Width="180"
									Height="40"
									Background="#555555"
									Foreground="White"/>
							<Button x:Name="PopulationTabButton"
									Content="👥 Population"
									Width="180"
									Height="40"
									Background="#555555"
									Foreground="White"/>
							<Button x:Name="GoodsTabButton"
									Content="📦 Goods Market"
									Width="180"
									Height="40"
									Background="#555555"
									Foreground="White"/>
						</StackPanel>

						<!-- Content Area -->
						<Grid Grid.Row="2">
							
							<!-- PRIVATE SECTOR TAB -->
							<Grid x:Name="PrivateSectorPanel" IsVisible="True">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="*"/>
								</Grid.RowDefinitions>

								<!-- Economic Indicators -->
								<Grid Grid.Row="0" Margin="0,0,0,15">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<Border Grid.Column="0" Background="#1A4A1A" Padding="12" Margin="0,0,5,0" CornerRadius="3">
										<StackPanel>
											<TextBlock Text="GDP" Foreground="#90EE90" FontWeight="Bold" FontSize="13"/>
											<TextBlock x:Name="GDPText" Text="$2.5T" Foreground="White" FontSize="18" FontWeight="Bold"/>
											<TextBlock Text="Growth: +3.2%" Foreground="#90EE90" FontSize="11"/>
										</StackPanel>
									</Border>

									<Border Grid.Column="1" Background="#4A1A1A" Padding="12" Margin="5,0" CornerRadius="3">
										<StackPanel>
											<TextBlock Text="Unemployment" Foreground="#F0E68C" FontWeight="Bold" FontSize="13"/>
											<TextBlock x:Name="UnemploymentText" Text="4.2%" Foreground="White" FontSize="18" FontWeight="Bold"/>
											<TextBlock Text="Change: -0.3%" Foreground="#90EE90" FontSize="11"/>
										</StackPanel>
									</Border>

                                                                        <Border Grid.Column="2" Background="#1A1A4A" Padding="12" Margin="5,0,0,0" CornerRadius="3">
                                                                                <StackPanel>
                                                                                        <TextBlock Text="Global Trade" Foreground="#ADD8E6" FontWeight="Bold" FontSize="13"/>
                                                                                        <TextBlock x:Name="GlobalTradeText" Text="$0" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                                                                        <TextBlock Text="Total value traded this turn" Foreground="#90EE90" FontSize="11"/>
                                                                                </StackPanel>
                                                                        </Border>
								</Grid>

								<!-- Companies List and Industries -->
								<Grid Grid.Row="1">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="2*"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<!-- Companies List -->
									<StackPanel Grid.Column="0" Margin="0,0,10,0">
										<TextBlock Text="Major Corporations" Foreground="#DDDDDD" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
										<ListBox x:Name="CorporationsList"
												 Background="#1A1A1A"
												 BorderBrush="#444444"
												 Height="320">
										<ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
									</StackPanel>

									<!-- Industries Summary -->
									<StackPanel Grid.Column="1">
										<TextBlock Text="Industries" Foreground="#DDDDDD" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
										<ListBox x:Name="IndustriesList"
												 Background="#1A1A1A"
												 BorderBrush="#444444"
												 Height="320">
										<ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
									</StackPanel>
								</Grid>
							</Grid>

							<!-- BUDGET TAB -->
							<Grid x:Name="BudgetPanel" IsVisible="False">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="*"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>

								<!-- Budget Summary -->
								<Grid Grid.Row="0" Margin="0,0,0,20">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<Border Grid.Column="0" Background="#1A4A1A" Padding="15" Margin="0,0,5,0" CornerRadius="3">
										<StackPanel>
											<TextBlock Text="Total Revenue" Foreground="#90EE90" FontWeight="Bold" FontSize="14"/>
											<TextBlock x:Name="TotalRevenueText" Text="$850M" Foreground="White" FontSize="20" FontWeight="Bold"/>
											<TextBlock Text="Per Month" Foreground="#AAAAAA" FontSize="12"/>
										</StackPanel>
									</Border>

									<Border Grid.Column="1" Background="#4A1A1A" Padding="15" Margin="5,0" CornerRadius="3">
										<StackPanel>
											<TextBlock Text="Total Expenses" Foreground="#F08080" FontWeight="Bold" FontSize="14"/>
											<TextBlock x:Name="TotalExpensesText" Text="$720M" Foreground="White" FontSize="20" FontWeight="Bold"/>
											<TextBlock Text="Per Month" Foreground="#AAAAAA" FontSize="12"/>
										</StackPanel>
									</Border>

									<Border Grid.Column="2" Background="#1A4A1A" Padding="15" Margin="5,0,0,0" CornerRadius="3">
										<StackPanel>
											<TextBlock Text="Budget Balance" Foreground="#ADD8E6" FontWeight="Bold" FontSize="14"/>
											<TextBlock x:Name="BudgetBalanceText" Text="+$130M" Foreground="#90EE90" FontSize="20" FontWeight="Bold"/>
											<TextBlock Text="Surplus" Foreground="#90EE90" FontSize="12"/>
										</StackPanel>
									</Border>
								</Grid>

								<!-- Budget Details -->
								<Grid Grid.Row="1">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<!-- Revenue Sources -->
									<StackPanel Grid.Column="0" Margin="0,0,10,0">
										<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
											<TextBlock Text="Revenue Sources" Foreground="#90EE90" FontWeight="Bold" FontSize="16"/>
											<TextBlock Text=" (Top 5)" Foreground="#AAAAAA" FontSize="14" Margin="5,0,0,0"/>
										</StackPanel>
										<ListBox x:Name="RevenueSourcesList"
												 Background="#1A1A1A"
												 BorderBrush="#444444"
												 Height="250">
										<ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        </ListBox>
									</StackPanel>

									<!-- Expense Categories -->
									<StackPanel Grid.Column="1">
										<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
											<TextBlock Text="Expense Categories" Foreground="#F08080" FontWeight="Bold" FontSize="16"/>
											<TextBlock Text=" (Top 5)" Foreground="#AAAAAA" FontSize="14" Margin="5,0,0,0"/>
										</StackPanel>
										<ListBox x:Name="ExpenseCategoriesList"
												 Background="#1A1A1A"
												 BorderBrush="#444444"
												 Height="250">
										<ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        </ListBox>
									</StackPanel>
								</Grid>

								<!-- Action Buttons -->
								<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15" Margin="0,15,0,0">
									<Button x:Name="ViewFullRevenueButton"
											Content="📊 View All Revenue Sources"
											Width="250"
											Height="40"
											Background="#1A4A1A"
											Foreground="White"/>
									<Button x:Name="ViewFullExpensesButton"
											Content="📊 View All Expenses"
											Width="250"
											Height="40"
											Background="#4A4A1A"
											Foreground="White"/>
								</StackPanel>
							</Grid>

							<!-- POPULATION TAB -->
							<Grid x:Name="PopulationPanel" IsVisible="False">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="*"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>

								<!-- Population Overview -->
								<Grid Grid.Row="0" Margin="0,0,0,20">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<Border Grid.Column="0" Background="#1A4A1A" Padding="15" Margin="0,0,5,0" CornerRadius="3">
										<StackPanel>
											<TextBlock Text="Avg Quality of Life" Foreground="#ADD8E6" FontWeight="Bold" FontSize="14"/>
											<TextBlock x:Name="AvgQoLText" Text="72%" Foreground="White" FontSize="20" FontWeight="Bold"/>
											<TextBlock Text="National Average" Foreground="#AAAAAA" FontSize="12"/>
										</StackPanel>
									</Border>

									<Border Grid.Column="1" Background="#1A4A1A" Padding="15" Margin="5,0" CornerRadius="3">
										<StackPanel>
											<TextBlock Text="Avg Happiness" Foreground="#90EE90" FontWeight="Bold" FontSize="14"/>
											<TextBlock x:Name="AvgHappinessText" Text="68%" Foreground="White" FontSize="20" FontWeight="Bold"/>
											<TextBlock Text="Population Sentiment" Foreground="#AAAAAA" FontSize="12"/>
										</StackPanel>
									</Border>

									<Border Grid.Column="2" Background="#4A1A4A" Padding="15" Margin="5,0,0,0" CornerRadius="3">
										<StackPanel>
											<TextBlock Text="Population Growth" Foreground="#F0E68C" FontWeight="Bold" FontSize="14"/>
											<TextBlock x:Name="PopGrowthRateText" Text="+0.7%" Foreground="White" FontSize="20" FontWeight="Bold"/>
											<TextBlock Text="Annual Rate" Foreground="#AAAAAA" FontSize="12"/>
										</StackPanel>
									</Border>
								</Grid>

								<!-- Population Class Distribution -->
								<StackPanel Grid.Row="1">
									<TextBlock Text="Population Classes" Foreground="#DDDDDD" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
									<ListBox x:Name="PopulationClassesList"
											 Background="#1A1A1A"
											 BorderBrush="#444444"
											 Height="280">
									<ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    </ListBox>
								</StackPanel>

								<!-- State Comparison Button -->
								<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
									<Button x:Name="ViewStateComparisonButton"
											Content="🗺️ Compare States Population"
											Width="300"
											Height="40"
											Background="#1A4A1A"
											Foreground="White"/>
								</StackPanel>
							</Grid>

							<!-- GOODS MARKET TAB -->
							<Grid x:Name="GoodsPanel" IsVisible="False">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="*"/>
								</Grid.RowDefinitions>

								<!-- Header with Summary Stats -->
								<Grid Grid.Row="0" Margin="0,0,0,20">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<Border Grid.Column="0" Background="#1A4A1A" Padding="15" Margin="0,0,5,0" CornerRadius="3">
										<StackPanel>
											<TextBlock Text="Total Goods Traded" Foreground="#90EE90" FontWeight="Bold" FontSize="14"/>
											<TextBlock x:Name="TotalGoodsTradedText" Text="0" Foreground="White" FontSize="20" FontWeight="Bold"/>
											<TextBlock Text="All Markets" Foreground="#AAAAAA" FontSize="12"/>
										</StackPanel>
									</Border>

									<Border Grid.Column="1" Background="#1A4A1A" Padding="15" Margin="5,0" CornerRadius="3">
										<StackPanel>
											<TextBlock Text="Total Market Value" Foreground="#ADD8E6" FontWeight="Bold" FontSize="14"/>
											<TextBlock x:Name="TotalMarketValueText" Text="$0" Foreground="White" FontSize="20" FontWeight="Bold"/>
											<TextBlock Text="Combined Value" Foreground="#AAAAAA" FontSize="12"/>
										</StackPanel>
									</Border>

									<Border Grid.Column="2" Background="#4A1A4A" Padding="15" Margin="5,0,0,0" CornerRadius="3">
										<StackPanel>
											<TextBlock Text="Active Goods" Foreground="#F0E68C" FontWeight="Bold" FontSize="14"/>
											<TextBlock x:Name="ActiveGoodsCountText" Text="0" Foreground="White" FontSize="20" FontWeight="Bold"/>
											<TextBlock Text="In Circulation" Foreground="#AAAAAA" FontSize="12"/>
										</StackPanel>
									</Border>
								</Grid>

								<!-- Goods List -->
								<StackPanel Grid.Row="1">
									<Grid Margin="0,0,0,10">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>
										<TextBlock Text="Goods Market Overview" Foreground="#DDDDDD" FontWeight="Bold" FontSize="16"/>
										<ComboBox x:Name="GoodsSortComboBox"
												  Grid.Column="1"
												  Width="150"
												  SelectedIndex="0">
											<ComboBoxItem Content="Sort by Price"/>
											<ComboBoxItem Content="Sort by Supply"/>
											<ComboBoxItem Content="Sort by Demand"/>
											<ComboBoxItem Content="Sort by Name"/>
										</ComboBox>
									</Grid>
									
									<ScrollViewer Height="300" VerticalScrollBarVisibility="Auto">
										<ListBox x:Name="GoodsMarketList"
												 Background="#1A1A1A"
												 BorderBrush="#444444">
											<ListBox.ItemTemplate>
												<DataTemplate>
													<Border Background="#2A2A2A" 
															Padding="12" 
															Margin="0,2"
															CornerRadius="3"
															BorderBrush="#444444"
															BorderThickness="1">
														<Grid>
															<Grid.ColumnDefinitions>
																<ColumnDefinition Width="200"/>
																<ColumnDefinition Width="*"/>
																<ColumnDefinition Width="120"/>
																<ColumnDefinition Width="120"/>
																<ColumnDefinition Width="120"/>
															</Grid.ColumnDefinitions>

															<StackPanel Grid.Column="0">
																<TextBlock Text="{Binding Name}" 
																		   Foreground="#FFD700" 
																		   FontWeight="Bold" 
																		   FontSize="14"/>
																<TextBlock Text="{Binding Category}" 
																		   Foreground="#AAAAAA" 
																		   FontSize="11"/>
															</StackPanel>

															<StackPanel Grid.Column="1" Margin="10,0">
																<TextBlock Foreground="#DDDDDD" FontSize="11">
																	<Run Text="Base Price: $"/>
																	<Run Text="{Binding BasePrice, StringFormat=F2}"/>
																</TextBlock>
															</StackPanel>

															<StackPanel Grid.Column="2">
																<TextBlock Text="Supply" Foreground="#90EE90" FontSize="11" FontWeight="Bold"/>
																<TextBlock Text="{Binding TotalSupply, StringFormat=N0}" 
																		   Foreground="White" 
																		   FontSize="13"/>
															</StackPanel>

															<StackPanel Grid.Column="3">
																<TextBlock Text="Demand" Foreground="#F08080" FontSize="11" FontWeight="Bold"/>
																<TextBlock Text="{Binding TotalDemand, StringFormat=N0}" 
																		   Foreground="White" 
																		   FontSize="13"/>
															</StackPanel>

															<StackPanel Grid.Column="4">
																<TextBlock Text="Avg Price" Foreground="#F0E68C" FontSize="11" FontWeight="Bold"/>
																<TextBlock Foreground="White" FontSize="13">
																	<Run Text="$"/>
																	<Run Text="{Binding AveragePrice, StringFormat=F2}"/>
																</TextBlock>
															</StackPanel>
														</Grid>
													</Border>
												</DataTemplate>
											</ListBox.ItemTemplate>
										</ListBox>
									</ScrollViewer>
								</StackPanel>
							</Grid>

						</Grid>
					</Grid>
				</Border>
			</Border>

			<!-- Company Details Popup -->
			<Border x:Name="CompanyDetailsOverlay"
					Background="#E6000000"
					IsVisible="False"
					ZIndex="6000"
					IsHitTestVisible="True">
				<Border Background="#2D2D30"
						BorderBrush="#555555"
						BorderThickness="2"
						CornerRadius="5"
						Width="800"
						Height="550"
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
					<Grid Margin="15">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>

						<!-- Header -->
						<Grid Grid.Row="0" Margin="0,0,0,15">
							<StackPanel Orientation="Horizontal">
								<TextBlock x:Name="CompanyNameText"
										   Text="US Steel Corporation"
										   FontSize="24"
										   FontWeight="Bold"
										   Foreground="#FFD700"/>
								<TextBlock x:Name="CompanyTypeText"
										   Text=" (Heavy Industry)"
										   FontSize="18"
										   Foreground="#AAAAAA"
										   VerticalAlignment="Bottom"
										   Margin="10,0,0,3"/>
							</StackPanel>
							<Button x:Name="CompanyDetailsCloseButton"
									Content="✕"
									Width="30"
									Height="30"
									HorizontalAlignment="Right"
									Background="#555555"
									Foreground="White"/>
						</Grid>

						<!-- Financial Overview -->
						<Grid Grid.Row="1" Margin="0,0,0,20">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<Border Grid.Column="0" Background="#1A4A1A" Padding="10" Margin="0,0,3,0" CornerRadius="3">
								<StackPanel>
									<TextBlock Text="Revenue" Foreground="#90EE90" FontWeight="Bold" FontSize="12"/>
									<TextBlock x:Name="CompanyRevenueText" Text="$12.5M" Foreground="White" FontSize="16" FontWeight="Bold"/>
								</StackPanel>
							</Border>

							<Border Grid.Column="1" Background="#1A4A1A" Padding="10" Margin="3,0" CornerRadius="3">
								<StackPanel>
									<TextBlock Text="Profit" Foreground="#ADD8E6" FontWeight="Bold" FontSize="12"/>
									<TextBlock x:Name="CompanyProfitText" Text="$3.2M" Foreground="White" FontSize="16" FontWeight="Bold"/>
								</StackPanel>
							</Border>

							<Border Grid.Column="2" Background="#4A1A4A" Padding="10" Margin="3,0" CornerRadius="3">
								<StackPanel>
									<TextBlock Text="Budget" Foreground="#F0E68C" FontWeight="Bold" FontSize="12"/>
									<TextBlock x:Name="CompanyBudgetText" Text="$8.7M" Foreground="White" FontSize="16" FontWeight="Bold"/>
								</StackPanel>
							</Border>

							<Border Grid.Column="3" Background="#2A2A4A" Padding="10" Margin="3,0,0,0" CornerRadius="3">
								<StackPanel>
									<TextBlock Text="Stock Price" Foreground="#DDA0DD" FontWeight="Bold" FontSize="12"/>
									<TextBlock x:Name="CompanyStockPriceText" Text="$125.30" Foreground="White" FontSize="16" FontWeight="Bold"/>
								</StackPanel>
							</Border>
						</Grid>

						<!-- Buildings and Details -->
						<Grid Grid.Row="2">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<!-- Buildings List -->
							<StackPanel Grid.Column="0" Margin="0,0,10,0">
								<TextBlock Text="Factories and Buildings" Foreground="#DDDDDD" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
								<ListBox x:Name="CompanyBuildingsList"
										 Background="#1A1A1A"
										 BorderBrush="#444444"
										 Height="280">
								<ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                </ListBox>
							</StackPanel>

							<!-- Building Details -->
							<StackPanel Grid.Column="1">
								<TextBlock Text="Building Details" Foreground="#DDDDDD" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
								<Border Background="#1A1A1A" BorderBrush="#444444" BorderThickness="1" CornerRadius="3" Padding="15" Height="280">
									<ScrollViewer VerticalScrollBarVisibility="Auto">
										<StackPanel x:Name="BuildingDetailsPanel" Spacing="10">
											<TextBlock Text="Select a building to view details" Foreground="#AAAAAA" TextAlignment="Center" Margin="0,100,0,0"/>
										</StackPanel>
									</ScrollViewer>
								</Border>
							</StackPanel>
						</Grid>
					</Grid>
				</Border>
			</Border>

			<!-- Full Revenue List Popup -->
			<Border x:Name="FullRevenueOverlay"
					Background="#E6000000"
					IsVisible="False"
					ZIndex="6000"
					IsHitTestVisible="True">
				<Border Background="#2D2D30"
						BorderBrush="#555555"
						BorderThickness="2"
						CornerRadius="5"
						Width="700"
						Height="500"
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
					<Grid Margin="15">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>

						<Grid Grid.Row="0" Margin="0,0,0,15">
							<TextBlock Text="All Revenue Sources"
									   FontSize="24"
									   FontWeight="Bold"
									   Foreground="#90EE90"
									   HorizontalAlignment="Left"/>
							<Button x:Name="FullRevenueCloseButton"
									Content="✕"
									Width="30"
									Height="30"
									HorizontalAlignment="Right"
									Background="#555555"
									Foreground="White"/>
						</Grid>

						<ListBox Grid.Row="1"
								 x:Name="FullRevenueList"
								 Background="#1A1A1A"
								 BorderBrush="#444444">
							<ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
						</ListBox>
					</Grid>
				</Border>
			</Border>

			<!-- Full Expenses List Popup -->
			<Border x:Name="FullExpensesOverlay"
					Background="#E6000000"
					IsVisible="False"
					ZIndex="6000"
					IsHitTestVisible="True">
				<Border Background="#2D2D30"
						BorderBrush="#555555"
						BorderThickness="2"
						CornerRadius="5"
						Width="700"
						Height="500"
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
					<Grid Margin="15">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>

						<Grid Grid.Row="0" Margin="0,0,0,15">
							<TextBlock Text="All Expenses"
									   FontSize="24"
									   FontWeight="Bold"
									   Foreground="#F08080"
									   HorizontalAlignment="Left"/>
							<Button x:Name="FullExpensesCloseButton"
									Content="✕"
									Width="30"
									Height="30"
									HorizontalAlignment="Right"
									Background="#555555"
									Foreground="White"/>
						</Grid>

						<ListBox Grid.Row="1"
								 x:Name="FullExpensesList"
								 Background="#1A1A1A"
								 BorderBrush="#444444">
							<ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
						</ListBox>
					</Grid>
				</Border>
			</Border>

			<!-- State Population Comparison Popup -->
			<Border x:Name="StateComparisonOverlay"
					Background="#E6000000"
					IsVisible="False"
					ZIndex="6000"
					IsHitTestVisible="True">
				<Border Background="#2D2D30"
						BorderBrush="#555555"
						BorderThickness="2"
						CornerRadius="5"
						Width="850"
						Height="550"
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
					<Grid Margin="15">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>

						<Grid Grid.Row="0" Margin="0,0,0,15">
							<TextBlock Text="State Population Comparison"
									   FontSize="24"
									   FontWeight="Bold"
									   Foreground="#ADD8E6"
									   HorizontalAlignment="Left"/>
							<Button x:Name="StateComparisonCloseButton"
									Content="✕"
									Width="30"
									Height="30"
									HorizontalAlignment="Right"
									Background="#555555"
									Foreground="White"/>
						</Grid>

						<ListBox Grid.Row="1"
								 x:Name="StateComparisonList"
								 Background="#1A1A1A"
								 BorderBrush="#444444">
							<ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
					</Grid>
				</Border>
			</Border>
		</Grid>

		<!-- Right-Side Menu Panel (Hidden by default) -->
        <Border Name="RightSideMenu" 
                Grid.Column="1" 
                Background="#DD1a1f2e" 
                IsVisible="False"
                CornerRadius="12 0 0 12"
                Margin="0,10,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Background="#1e293b" Padding="20,15" CornerRadius="12 0 0 0" Grid.Row="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="SideMenuTitleText" 
                                   Grid.Column="0"
                                   Text="Details" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="White"/>
                        <Button Name="SideMenuCloseButton" 
                                Grid.Column="1"
                                Content="✕" 
                                FontSize="20" 
                                Padding="12,6"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </Grid>
                </Border>

                <!-- Content ScrollViewer -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="15,10">
                    <StackPanel Spacing="15">
                        
                        <!-- DIPLOMACY PANEL -->
                        <StackPanel Name="SideDiplomacyPanel" IsVisible="False" Spacing="15">
                            <!-- Content here -->
                            <TextBlock Text="Diplomacy panel content" Foreground="White"/>
                        </StackPanel>

                        <!-- TRADE PANEL -->
                        <StackPanel x:Name="SideTradePanel" IsVisible="False" Spacing="12">
                            <TextBlock Text="Trade Overview" Foreground="#FFD700" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="{Binding TradeSummaryText}" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding Aggregates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#CCCCCC"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Top Exports" Foreground="#90EE90" FontWeight="Bold"/>
                            <ListBox x:Name="SideExportsList" ItemsSource="{Binding Exports}" Background="#1A1A1A" BorderBrush="#444444" Height="100"/>
                            <TextBlock Text="Top Imports" Foreground="#FFB6C1" FontWeight="Bold"/>
                            <ListBox x:Name="SideImportsList" ItemsSource="{Binding Imports}" Background="#1A1A1A" BorderBrush="#444444" Height="100"/>
                            <TextBlock Text="Recent Trade Events" Foreground="#87CEFA" FontWeight="Bold"/>
                            <ListBox x:Name="SideRecentEventsList" ItemsSource="{Binding RecentTradeEvents}" Background="#1A1A1A" BorderBrush="#444444" Height="120"/>
                        </StackPanel>

                        <!-- CONSTRUCTION PANEL -->
                        <StackPanel Name="SideConstructionPanel" IsVisible="False" Spacing="12">
                            <TextBlock Text="City Construction" Foreground="#FFD700" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="{Binding CityBudgetDisplay}" Foreground="#FFFFFF"/>
                            <TextBlock Text="{Binding TotalAllocatedBudgetDisplay}" Foreground="#FFFFFF"/>
                            <TextBlock Text="{Binding EstimatedDailyCostDisplay}" Foreground="#FFFFFF"/>
                            <ListBox ItemsSource="{Binding ActiveProjects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}" Background="#1A1A1A" BorderBrush="#444444" Height="220">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontWeight="Bold"/>
                                            <ProgressBar Minimum="0" Maximum="100" Height="4" Value="{Binding ProgressPercentage}"/>
                                            <TextBlock Text="{Binding ProgressText}" Foreground="#CCCCCC" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding SelectedProjectSummary}" Foreground="#CCCCCC" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- ECONOMY PANEL -->
                        <StackPanel Name="SideEconomyPanel" IsVisible="False" Spacing="15">
                            <TextBlock Text="Economy Overview" Foreground="White" FontWeight="Bold" FontSize="16"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Global Trade:" Foreground="#ADD8E6"/>
                                <TextBlock x:Name="SideGlobalTradeText" Text="$0" Foreground="White" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="Live indicators update each tick" Foreground="#CCCCCC" FontSize="12"/>
                        </StackPanel>

                        <!-- STATS PANEL -->
                        <StackPanel Name="SideStatsPanel" IsVisible="False" Spacing="15">
                            <!-- Content here -->
                            <TextBlock Text="Stats panel content" Foreground="White"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
	</Grid>
</Window>