<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Economy_sim.GameView"
        Title="GameView"
     WindowState="FullScreen"
        Background="#2D2D30"
        Width="2560" Height="1440">
	<Image x:Name="MapImage"
		   Stretch="Fill"
		   ClipToBounds="True"/>
</Window>
